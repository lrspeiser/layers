# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev.*.log
.dev-*.log
.vinext-*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.sites-stage/
/.sites-stage-v*/
/layers-sites-build.tar.gz
/layers-sites-build-v*.tar.gz
/.wrangler/
/outputs/
/work/
*.tsbuildinfo
__pycache__/
.venv/
/pipeline/output/
/pipeline/cache/
# pipeline/results holds retrieved and derived science data (tens of GB of FITS,
# caches, and run logs). It is reproducible from the fetch scripts and manifests;
# published artifacts are copied into public/data instead. See docs/DATA_STORAGE.md.
/pipeline/results/*
!/pipeline/results/dp2-sparc-coverage.json
!/pipeline/results/public-legacy-overlap.json
/public/private-preview/
/public/data/coverage/rubin-pixels-50-pilot.json
/public/data/coverage/rubin-pixels-50-pilot/
